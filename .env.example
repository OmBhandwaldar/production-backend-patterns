# Copy to .env. Never commit real secrets — in prod these come from a secrets
# manager (Infisical, Vault, AWS Secrets Manager), injected at runtime.
DATABASE_URL="postgresql://app:app@localhost:5432/approval?schema=public"
REDIS_URL="redis://localhost:6379"

# Two SEPARATE secrets so a leaked access-token secret can't forge refresh tokens.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900"        # 15 minutes, in seconds
JWT_REFRESH_TTL="1209600"   # 14 days, in seconds

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
