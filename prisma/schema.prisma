// Prisma schema — grows incrementally across the 8 sections.
// §1 (now): User + Transaction, enough to demonstrate layered architecture.
// Later: §2 RefreshToken, §3 Role/Permission, §4 AuditLog + states,
//        §5 IdempotencyKey, §6 version column for optimistic locking.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // password hash added in §2 (auth). Present now so seed users are realistic.
  passwordHash String
  createdAt    DateTime @default(now())

  // §3 RBAC: one role per user (FK to the Role table). Nullable so the migration
  // applies to existing rows; the seed assigns roles. The role NAME is embedded
  // in the JWT for the cheap coarse check; permissions are resolved from the DB.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  // §3: bumping this invalidates all of a user's existing access tokens at once
  // (instant role revocation / "log out everywhere"). Embedded in the JWT as
  // `ver`; authenticate rejects tokens whose ver != the user's current value.
  tokenVersion Int @default(0)

  // A user can be the MAKER of many transactions. The checker relation is
  // added in §4 when we build the maker-checker workflow.
  transactions  Transaction[]  @relation("MakerTransactions")
  refreshTokens RefreshToken[]
}

// §3 RBAC: a Role is a named bundle of Permissions. Users are ASSIGNED roles;
// routes are ENFORCED on permissions. Many-to-many with Permission (implicit
// join table — no extra columns needed on the relation).
model Role {
  id          String       @id @default(uuid())
  name        String       @unique // "admin" | "maker" | "checker"
  permissions Permission[] @relation("RolePermissions")
  users       User[]
}

// A single capability, named `resource:action` (e.g. "transaction:approve").
model Permission {
  id    String @id @default(uuid())
  name  String @unique
  roles Role[] @relation("RolePermissions")
}

// §2: Refresh tokens are stored server-side so they can be REVOKED and ROTATED
// (unlike the stateless access token). This is what makes logout / reuse
// detection possible.
model RefreshToken {
  id     String @id @default(uuid())
  // We store a HASH of the token, never the raw value — same reasoning as
  // passwords: a DB leak must not hand an attacker usable tokens.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  // ROTATION + REUSE DETECTION:
  //  - revokedAt: set when this token is rotated out or the user logs out.
  //  - replacedById: the token that superseded this one on rotation. If a
  //    client presents an already-revoked token, we know it was stolen/replayed
  //    and can revoke the whole chain.
  revokedAt    DateTime?
  replacedById String?

  @@index([userId])
}

model Transaction {
  id        String   @id @default(uuid())
  // Money as an integer in the smallest unit (cents). NEVER float for money —
  // floats can't represent 0.10 exactly, causing rounding drift. (§4/§6 detail.)
  amount    BigInt
  currency  String   @default("USD")
  reference String? // human note, e.g. "invoice 1234"

  // §1: transactions start life as DRAFT. Full state machine arrives in §4.
  status    String   @default("DRAFT")

  makerId   String
  maker     User     @relation("MakerTransactions", fields: [makerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([makerId])
  @@index([status])
}
